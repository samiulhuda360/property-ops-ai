generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A property company. Every property, tenant, document, bank line, message, lease, run and audit event belongs to
// one organisation, and every request is scoped to the signed-in user's organisation.
model Organisation {
  id               Int               @id @default(autoincrement())
  name             String
  slug             String            @unique
  country          String            @default("NZ")
  currency         String            @default("NZD")
  createdAt        DateTime          @default(now())
  users            User[]
  properties       Property[]
  tenants          Tenant[]
  contractors      Contractor[]
  documents        Document[]
  bankTransactions BankTransaction[]
  inboxMessages    InboxMessage[]
  automationRuns   AutomationRun[]
  leaseAbstracts   LeaseAbstract[]
  issuedInvoices   IssuedInvoice[]
  auditEvents      AuditEvent[]
  rentMonths       RentMonth[]
  tenantRisks      TenantRisk[]
}

model User {
  id               Int               @id @default(autoincrement())
  organisationId   Int
  organisation     Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  email            String            @unique
  password         String
  name             String
  role             String            @default("manager") // manager | accounts | property_manager | read_only
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  properties       Property[]
  tenants          Tenant[]
  contractors      Contractor[]
  documents        Document[]
  bankTransactions BankTransaction[]
  inboxMessages    InboxMessage[]
  automationRuns   AutomationRun[]
  leaseAbstracts   LeaseAbstract[]
  issuedInvoices   IssuedInvoice[]
  auditEvents      AuditEvent[]
}

model Property {
  id             Int                  @id @default(autoincrement())
  userId         Int
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId Int
  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  code           String? // short code used in bank references, e.g. MTE14
  address        String
  suburb         String
  city           String
  bedrooms       Int
  bathrooms      Float
  rentPrice      Float
  marketRent     Float? // the benchmark rent for a home like this one, for the rent-to-benchmark risk feature
  status         String               @default("vacant") // vacant | tenanted | maintenance
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  leases         Lease[]
  maintenance    MaintenanceRequest[]
  documents      Document[]
  inboxMessages  InboxMessage[]
  leaseAbstracts LeaseAbstract[]
}

model Tenant {
  id             Int            @id @default(autoincrement())
  userId         Int
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId Int
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  email          String
  phone          String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  leases         Lease[]
  inboxMessages  InboxMessage[]
  risks          TenantRisk[]
}

model Lease {
  id            Int            @id @default(autoincrement())
  propertyId    Int
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId      Int
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime?
  weeklyRent    Float
  bondAmount    Float
  rentReference String? // what the tenant puts on bank payments, e.g. NGATA MTE14
  status        String         @default("active") // active | ended
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  payments      Payment[]
  documents     Document[]
  inboxMessages InboxMessage[]
  rentMonths    RentMonth[]
  risks         TenantRisk[]
}

model Payment {
  id               Int               @id @default(autoincrement())
  leaseId          Int
  lease            Lease             @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  amount           Float
  dueDate          DateTime
  paidDate         DateTime?
  status           String            @default("pending") // pending | paid | overdue
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bankTransactions BankTransaction[]
}

model MaintenanceRequest {
  id            Int            @id @default(autoincrement())
  propertyId    Int
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contractorId  Int?
  contractor    Contractor?    @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  title         String
  description   String
  priority      String         @default("medium") // low | medium | high | urgent
  status        String         @default("open") // open | in_progress | completed
  source        String         @default("manual") // manual | inbox | tenant_request
  category      String? // plumbing | electrical | gas_heating | water_leak | security | pest | appliance | structural | general
  triage        Json? // category, urgency, safety flags, reasons, method, contractor suggestions, budget band
  workOrder     Json? // the draft work order: scope, access notes, budget band, contractor; a person approves it
  triageMethod  String? // rules | llm+rules
  photoNote     String? // the tenant's description of the photo they attached, if any
  approvedAt    DateTime?
  reviewSeconds Int?
  quoteAmount   Float?
  cost          Float?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  documents     Document[]
  inboxMessages InboxMessage[]
}

// A business that invoices the property manager: trades, utilities, insurers.
model Contractor {
  id             Int                  @id @default(autoincrement())
  userId         Int
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId Int
  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  trade          String // plumbing | electrical | cleaning | gardening | locksmith | roofing | pest_control | insurance | utilities
  email          String?
  gstNumber      String?
  bankAccount    String?
  available      Boolean              @default(true) // taking new jobs right now
  availableFrom  DateTime? // when an unavailable contractor is back
  notes          String? // e.g. "after-hours call-outs", "no roof work"
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  maintenance    MaintenanceRequest[]
  documents      Document[]
}

// An uploaded PDF (a supplier invoice or a lease summary) and what was extracted from it.
model Document {
  id                   Int                 @id @default(autoincrement())
  userId               Int
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId       Int
  organisation         Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  kind                 String // invoice | lease
  fileName             String
  storagePath          String?
  text                 String // the PDF's text layer
  method               String // rules | llm | llm+validation
  extracted            Json // { field: { value, confidence, source } }
  issues               Json // validation issues: [{ field, message, severity }]
  status               String              @default("needs_review") // needs_review | approved | rejected | exported
  propertyId           Int?
  property             Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  contractorId         Int?
  contractor           Contractor?         @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  maintenanceRequestId Int?
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)
  leaseId              Int?
  lease                Lease?              @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  invoiceNumber        String?
  invoiceDate          DateTime?
  dueDate              DateTime?
  total                Float?
  gst                  Float?
  reviewedAt           DateTime?
  reviewSeconds        Int?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  bankTransactions     BankTransaction[]
}

// One line of an imported bank statement, and what it was matched to.
model BankTransaction {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  importBatch    String
  date           DateTime
  amount         Float // money in is positive, money out is negative
  description    String
  particulars    String?
  code           String?
  reference      String?
  matchStatus    String       @default("unmatched") // matched | exception | unmatched | ignored
  matchType      String? // rent | contractor | bond | refund | fee | transfer | other
  exception      String? // why a person needs to look, e.g. underpaid, unknown_payer, duplicate
  paymentId      Int?
  payment        Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  documentId     Int?
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  lineHash       String? // fingerprint of the line's fields and its occurrence in the file; a re-import skips known lines
  details        Json? // the match: method, confidence, tenancy, rent weeks allocated, job, explanation, suggested action
  aiSuggestion   Json? // the model's suggestion for an unknown or ambiguous line; shown to a person, never applied
  resolution     Json? // a person's decision on an exception: accept | reassign | ignore, note, review seconds
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, lineHash])
  @@index([organisationId, importBatch])
}

// An email received through the inbox webhook, and the triage result.
model InboxMessage {
  id                   Int                 @id @default(autoincrement())
  userId               Int
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId       Int
  organisation         Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  externalId           String?
  fromAddress          String
  subject              String
  body                 String
  receivedAt           DateTime            @default(now())
  category             String? // maintenance | rent | lease_question | complaint | end_of_tenancy | other
  urgency              String? // urgent | high | normal | low
  needsPerson          Boolean             @default(true)
  reason               String?
  replyDraft           String?
  citedClause          String?
  status               String              @default("new") // new | triaged | approved | sent | dismissed
  method               String? // how the triage was produced: rules | llm+rules
  triage               Json? // summary, reasons, guard flags, clause candidates, ticket decision, the system draft
  tenantId             Int?
  tenant               Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  propertyId           Int?
  property             Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  leaseId              Int?
  lease                Lease?              @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  maintenanceRequestId Int?
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  reviewSeconds        Int?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  // The webhook's messageId: one stored message per id and account, even when deliveries race.
  @@unique([organisationId, externalId])
}

// One item an automation handled. The hours-returned report is built from these rows.
model AutomationRun {
  id              Int          @id @default(autoincrement())
  userId          Int
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId  Int
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  automation      String // invoice_extraction | lease_extraction | rent_reconciliation | inbox_triage
  itemRef         String // e.g. document:12, bank:340, inbox:7
  baselineMinutes Float // minutes the task takes by hand, from the discovery timings
  reviewSeconds   Int          @default(0) // time a person spent checking the automation's work
  outcome         String // auto | reviewed | corrected | rejected | failed
  createdAt       DateTime     @default(now())

  @@index([organisationId, createdAt])
}

// Every model call, for cost, latency and failure monitoring.
model AiCall {
  id           Int      @id @default(autoincrement())
  feature      String
  model        String
  latencyMs    Int
  inputTokens  Int?
  outputTokens Int?
  cached       Boolean  @default(false)
  error        String?
  createdAt    DateTime @default(now())
}

// An uploaded lease and its abstraction: the key terms with page, quote and confidence; the checks; the risk
// findings; the charge schedule; and the reconciliation against issued invoices.
model LeaseAbstract {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  fileName       String
  storagePath    String?
  pages          Json // [{ num, text }]
  country        String? // NZ | AU | UK | US
  leaseType      String? // commercial | residential
  route          String // rules | llm | hybrid
  leaseRef       String?
  terms          Json // { field: { value, page, quote, confidence, source, status } }
  issues         Json // validation issues: [{ code, field, fields, message, severity }]
  risks          Json // playbook findings: [{ code, title, severity, explanation, page, quote, status }]
  charges        Json // charge schedule for the first twelve months
  reconciliation Json? // charges against issued invoices
  status         String       @default("needs_review") // needs_review | approved | rejected
  propertyId     Int?
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  reviewSeconds  Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  auditEvents    AuditEvent[]

  @@index([organisationId, status])
}

// An invoice the billing system issued to a tenant, imported for reconciliation against the lease's charge schedule.
model IssuedInvoice {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invoiceNumber  String
  sourceRow      Int // the row of the import file, for citing
  leaseRef       String
  description    String
  kind           String // rent | outgoings | bond | other
  amount         Float
  currency       String
  dueDate        DateTime
  period         String?
  createdAt      DateTime     @default(now())

  @@unique([organisationId, invoiceNumber])
  @@index([organisationId, leaseRef])
}

// Who did what to a lease abstraction: every extraction, per-field approval or correction, risk decision and
// final approval, so a manager can see who approved what and when.
model AuditEvent {
  id              Int            @id @default(autoincrement())
  userId          Int
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId  Int
  organisation    Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  leaseAbstractId Int?
  leaseAbstract   LeaseAbstract? @relation(fields: [leaseAbstractId], references: [id], onDelete: Cascade)
  action          String // lease.extracted | lease.field_approved | ... | document.approved | inbox.approved | bank.resolved | risk.approved | maintenance.triaged | maintenance.work_order_approved
  entity          String? // lease | document | inbox | bank | risk | maintenance
  entityId        Int?
  field           String?
  before          Json?
  after           Json?
  note            String?
  createdAt       DateTime       @default(now())

  @@index([leaseAbstractId, createdAt])
  @@index([organisationId, createdAt])
  @@index([organisationId, entity, entityId])
}

// One month of rent for a tenancy: what was due, what was paid and how late. Twenty-four months of these per
// tenancy feed the arrears-risk features.
model RentMonth {
  id             Int          @id @default(autoincrement())
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  leaseId        Int
  lease          Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  month          String // YYYY-MM
  dueDate        DateTime
  rentDue        Float
  paidAmount     Float        @default(0)
  paidDate       DateTime?
  daysLate       Int          @default(0) // 0 when paid on or before the due date; the days to the last payment otherwise
  arrears30      Boolean      @default(false) // the month's rent was still short 30 days after it fell due

  @@unique([leaseId, month])
  @@index([organisationId, month])
}

// The arrears-risk score for a tenancy: the probability, the band, the top reasons in plain words and the suggested
// next step as a draft for a person to approve.
model TenantRisk {
  id             Int          @id @default(autoincrement())
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  tenantId       Int
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaseId        Int
  lease          Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  scoredAt       DateTime     @default(now())
  asOfMonth      String // the last month of history the score used
  probability    Float
  band           String // low | medium | high
  reasons        Json // [{ feature, text, weight }]
  features       Json // the feature values the score was computed from
  nextStep       String // none | reminder | call | payment_plan
  draft          String // the suggested message or call note, for a person to edit and approve
  status         String       @default("draft") // draft | approved | dismissed
  modelVersion   String
  approvedAt     DateTime?
  reviewSeconds  Int?
  note           String?

  @@unique([tenantId, leaseId])
  @@index([organisationId, band])
}

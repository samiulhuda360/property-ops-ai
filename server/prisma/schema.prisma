generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  email            String            @unique
  password         String
  name             String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  properties       Property[]
  tenants          Tenant[]
  contractors      Contractor[]
  documents        Document[]
  bankTransactions BankTransaction[]
  inboxMessages    InboxMessage[]
  automationRuns   AutomationRun[]
  leaseAbstracts   LeaseAbstract[]
  issuedInvoices   IssuedInvoice[]
  auditEvents      AuditEvent[]
}

model Property {
  id             Int                  @id @default(autoincrement())
  userId         Int
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  code           String? // short code used in bank references, e.g. MTE14
  address        String
  suburb         String
  city           String
  bedrooms       Int
  bathrooms      Float
  rentPrice      Float
  status         String               @default("vacant") // vacant | tenanted | maintenance
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  leases         Lease[]
  maintenance    MaintenanceRequest[]
  documents      Document[]
  inboxMessages  InboxMessage[]
  leaseAbstracts LeaseAbstract[]
}

model Tenant {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  email         String
  phone         String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  leases        Lease[]
  inboxMessages InboxMessage[]
}

model Lease {
  id            Int            @id @default(autoincrement())
  propertyId    Int
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId      Int
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime?
  weeklyRent    Float
  bondAmount    Float
  rentReference String? // what the tenant puts on bank payments, e.g. NGATA MTE14
  status        String         @default("active") // active | ended
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  payments      Payment[]
  documents     Document[]
  inboxMessages InboxMessage[]
}

model Payment {
  id               Int               @id @default(autoincrement())
  leaseId          Int
  lease            Lease             @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  amount           Float
  dueDate          DateTime
  paidDate         DateTime?
  status           String            @default("pending") // pending | paid | overdue
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bankTransactions BankTransaction[]
}

model MaintenanceRequest {
  id            Int            @id @default(autoincrement())
  propertyId    Int
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contractorId  Int?
  contractor    Contractor?    @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  title         String
  description   String
  priority      String         @default("medium") // low | medium | high | urgent
  status        String         @default("open") // open | in_progress | completed
  source        String         @default("manual") // manual | inbox
  quoteAmount   Float?
  cost          Float?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  documents     Document[]
  inboxMessages InboxMessage[]
}

// A business that invoices the property manager: trades, utilities, insurers.
model Contractor {
  id          Int                  @id @default(autoincrement())
  userId      Int
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  trade       String // plumbing | electrical | cleaning | gardening | locksmith | roofing | pest_control | insurance | utilities
  email       String?
  gstNumber   String?
  bankAccount String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  maintenance MaintenanceRequest[]
  documents   Document[]
}

// An uploaded PDF (a supplier invoice or a lease summary) and what was extracted from it.
model Document {
  id                   Int                 @id @default(autoincrement())
  userId               Int
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind                 String // invoice | lease
  fileName             String
  storagePath          String?
  text                 String // the PDF's text layer
  method               String // rules | llm | llm+validation
  extracted            Json // { field: { value, confidence, source } }
  issues               Json // validation issues: [{ field, message, severity }]
  status               String              @default("needs_review") // needs_review | approved | rejected | exported
  propertyId           Int?
  property             Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  contractorId         Int?
  contractor           Contractor?         @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  maintenanceRequestId Int?
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)
  leaseId              Int?
  lease                Lease?              @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  invoiceNumber        String?
  invoiceDate          DateTime?
  dueDate              DateTime?
  total                Float?
  gst                  Float?
  reviewedAt           DateTime?
  reviewSeconds        Int?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  bankTransactions     BankTransaction[]
}

// One line of an imported bank statement, and what it was matched to.
model BankTransaction {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  importBatch  String
  date         DateTime
  amount       Float // money in is positive, money out is negative
  description  String
  particulars  String?
  code         String?
  reference    String?
  matchStatus  String    @default("unmatched") // matched | exception | unmatched | ignored
  matchType    String? // rent | contractor | bond | refund | fee | transfer | other
  exception    String? // why a person needs to look, e.g. underpaid, unknown_payer, duplicate
  paymentId    Int?
  payment      Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  documentId   Int?
  document     Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  lineHash     String? // fingerprint of the line's fields and its occurrence in the file; a re-import skips known lines
  details      Json? // the match: method, confidence, tenancy, rent weeks allocated, job, explanation, suggested action
  aiSuggestion Json? // the model's suggestion for an unknown or ambiguous line; shown to a person, never applied
  resolution   Json? // a person's decision on an exception: accept | reassign | ignore, note, review seconds
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, lineHash])
  @@index([userId, importBatch])
}

// An email received through the inbox webhook, and the triage result.
model InboxMessage {
  id                   Int                 @id @default(autoincrement())
  userId               Int
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId           String?
  fromAddress          String
  subject              String
  body                 String
  receivedAt           DateTime            @default(now())
  category             String? // maintenance | rent | lease_question | complaint | end_of_tenancy | other
  urgency              String? // urgent | high | normal | low
  needsPerson          Boolean             @default(true)
  reason               String?
  replyDraft           String?
  citedClause          String?
  status               String              @default("new") // new | triaged | approved | sent | dismissed
  method               String? // how the triage was produced: rules | llm+rules
  triage               Json? // summary, reasons, guard flags, clause candidates, ticket decision, the system draft
  tenantId             Int?
  tenant               Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  propertyId           Int?
  property             Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  leaseId              Int?
  lease                Lease?              @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  maintenanceRequestId Int?
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  reviewSeconds        Int?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  // The webhook's messageId: one stored message per id and account, even when deliveries race.
  @@unique([userId, externalId])
}

// One item an automation handled. The hours-returned report is built from these rows.
model AutomationRun {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  automation      String // invoice_extraction | lease_extraction | rent_reconciliation | inbox_triage
  itemRef         String // e.g. document:12, bank:340, inbox:7
  baselineMinutes Float // minutes the task takes by hand, from the discovery timings
  reviewSeconds   Int      @default(0) // time a person spent checking the automation's work
  outcome         String // auto | reviewed | corrected | rejected | failed
  createdAt       DateTime @default(now())
}

// Every model call, for cost, latency and failure monitoring.
model AiCall {
  id           Int      @id @default(autoincrement())
  feature      String
  model        String
  latencyMs    Int
  inputTokens  Int?
  outputTokens Int?
  cached       Boolean  @default(false)
  error        String?
  createdAt    DateTime @default(now())
}

// An uploaded lease and its abstraction: the key terms with page, quote and confidence; the checks; the risk
// findings; the charge schedule; and the reconciliation against issued invoices.
model LeaseAbstract {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName       String
  storagePath    String?
  pages          Json // [{ num, text }]
  country        String? // NZ | AU | UK | US
  leaseType      String? // commercial | residential
  route          String // rules | llm | hybrid
  leaseRef       String?
  terms          Json // { field: { value, page, quote, confidence, source, status } }
  issues         Json // validation issues: [{ code, field, fields, message, severity }]
  risks          Json // playbook findings: [{ code, title, severity, explanation, page, quote, status }]
  charges        Json // charge schedule for the first twelve months
  reconciliation Json? // charges against issued invoices
  status         String       @default("needs_review") // needs_review | approved | rejected
  propertyId     Int?
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  reviewSeconds  Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  auditEvents    AuditEvent[]

  @@index([userId, status])
}

// An invoice the billing system issued to a tenant, imported for reconciliation against the lease's charge schedule.
model IssuedInvoice {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceNumber String
  sourceRow     Int // the row of the import file, for citing
  leaseRef      String
  description   String
  kind          String // rent | outgoings | bond | other
  amount        Float
  currency      String
  dueDate       DateTime
  period        String?
  createdAt     DateTime @default(now())

  @@unique([userId, invoiceNumber])
  @@index([userId, leaseRef])
}

// Who did what to a lease abstraction: every extraction, per-field approval or correction, risk decision and
// final approval, so a manager can see who approved what and when.
model AuditEvent {
  id              Int            @id @default(autoincrement())
  userId          Int
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaseAbstractId Int?
  leaseAbstract   LeaseAbstract? @relation(fields: [leaseAbstractId], references: [id], onDelete: Cascade)
  action          String // lease.extracted | lease.field_approved | lease.field_corrected | lease.risk_reviewed | lease.approved | lease.rejected
  field           String?
  before          Json?
  after           Json?
  note            String?
  createdAt       DateTime       @default(now())

  @@index([leaseAbstractId, createdAt])
}

DATABASE_URL=postgresql://postgres@localhost:5432/property_ops
JWT_SECRET=change-me
PORT=3001
# AI (optional): any OpenAI-compatible chat API. Leave AI_API_KEY empty, or set AI_DRIVER=off, to use the rules only.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-flash-lite-latest
AI_DRIVER=
# AI_DRIVER=replay answers only from the committed caches (data/leases/model-cache, data/maintenance/model-cache):
# no key, no network, a miss is an error.
# AI_MIN_INTERVAL=4.5 spaces live lease and triage calls on a shared quota.
